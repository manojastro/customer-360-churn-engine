# File: .env.example
# Copy to `.env` and fill in values. Never commit real credentials.

# --- Snowflake connection (dbt + Snowpark) ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=svc_churn_engineer
# Either password OR key-pair auth (key path wins when set)
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=/secure/keys/svc_churn_engineer.p8
SNOWFLAKE_ROLE=CHURN_ENGINEER
SNOWFLAKE_WAREHOUSE=WH_TRANSFORM
SNOWFLAKE_DATABASE=ANALYTICS

# --- Churn scoring pipeline ---
CHURN_MODEL_STAGE_PATH=@ML.ARTIFACTS/model/churn_xgb_v1.json
CHURN_HIGH_RISK_THRESHOLD=0.7
LOG_LEVEL=INFO

# --- dbt ---
DBT_ENV=dev
